datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth.js Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  syncHistoryId     String? // For Gmail history sync

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  GUEST
  USER
  PREMIUM
  ELITE
  ADMIN
  SUPER_ADMIN
}

enum WhitelistStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               UserRole        @default(USER)
  isWhitelisted      Boolean         @default(false)
  whitelistStatus    WhitelistStatus @default(NONE)
  subscriptionPlanId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastLoginAt        DateTime?

  accounts          Account[]
  sessions          Session[]
  profile           UserProfile?
  businessProfiles  UserBusinessProfile[]
  moduleOverrides   UserModuleOverride[]
  featureAccessLogs FeatureAccessLog[]
  leads             Lead[]
  activityLogs      ActivityLog[]
  credits           Int                 @default(50)
  creditTransactions CreditTransaction[]
  marketplaceListings MarketplaceListing[]
  outreachEmails    OutreachEmail[]      @relation("OutreachEmails")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  companyName        String?
  website            String?
  preferredLanguage  String  @default("en")
  preferredTone      String  @default("professional")
  country            String?
  timezone           String?
  targetCustomers    String?
  serviceDescription String? 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stubs for Business profiles, to be expanded in Phase 2
model BusinessType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProfiles        UserBusinessProfile[]
  businessTypeModules BusinessTypeModule[]
  purposeOptions      LeadPurposeOption[]
  leads               Lead[]
  crmStatuses         BusinessTypeCRMStatus[]
}

model UserBusinessProfile {
  id                 String   @id @default(cuid())
  userId             String
  businessTypeId     String
  companyName        String?
  website            String?
  serviceDescription String?  
  targetCustomers    String?
  preferredTone      String?
  preferredLanguage  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, businessTypeId])
}

model Module {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String?
  isInternal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessTypes BusinessTypeModule[]
  userOverrides UserModuleOverride[]
  accessLogs    FeatureAccessLog[]
}

model BusinessTypeModule {
  id                String   @id @default(cuid())
  businessTypeId    String
  moduleId          String
  enabled           Boolean  @default(true)
  requiresWhitelist Boolean  @default(false)
  requiresPremium   Boolean  @default(false)
  minimumRole       UserRole @default(USER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([businessTypeId, moduleId])
}

model UserModuleOverride {
  id           String   @id @default(cuid())
  userId       String
  moduleId     String
  enabled      Boolean
  reason       String?
  setByAdminId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model FeatureAccessLog {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  action    String
  allowed   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model LeadPurposeOption {
  id             String   @id @default(cuid())
  businessTypeId String?
  label          String
  value          String
  description    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessType BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
}

model Lead {
  id                         String    @id @default(cuid())
  ownerUserId                String
  companyName                String
  websiteUrl                 String?
  industry                   String?
  country                    String?
  city                       String?
  contactEmail               String?
  phone                      String?
  linkedinUrl                String?
  googleBusinessUrl          String?
  sourceUrl                  String?
  sourceType                 String?
  discoveryMethod            String?
  searchTier                 String?
  leadPurpose                String?
  businessTypeId             String?
  leadScore                  Int       @default(0)
  fitScore                   Int       @default(0)
  websiteWeaknessScore       Int       @default(0)
  contactabilityScore        Int       @default(0)
  urgencyScore               Int       @default(0)
  revenuePotentialScore      Int       @default(0)
  conversionProbabilityScore Int       @default(0)
  dataQualityScore           Int       @default(0)
  confidenceScore            Int       @default(0)
  status                     String    @default("NEW")
  duplicateOfLeadId          String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastVerifiedAt             DateTime?

  owner             User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  businessType      BusinessType?      @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
  activityLogs      ActivityLog[]
  websiteAnalysis   WebsiteAnalysis?
  opportunityReport OpportunityReport?
  outreachEmails    OutreachEmail[]
  websiteProjects   WebsiteProject[]
  marketplaceListing MarketplaceListing?
  
  duplicateOf Lead?  @relation("LeadDuplicates", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicates  Lead[] @relation("LeadDuplicates")
}

model BusinessTypeCRMStatus {
  id             String  @id @default(cuid())
  businessTypeId String
  label          String
  value          String
  color          String  @default("gray")
  sortOrder      Int     @default(0)
  isDefault      Boolean @default(false)
  isActive       Boolean @default(true)

  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  leadId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model WebsiteAnalysis {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  overallScore       Int
  performanceScore   Int
  seoScore           Int
  accessibilityScore Int
  designScore        Int
  weaknesses         Json
  opportunities      Json
  screenshotUrl      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model OpportunityReport {
  id              String   @id @default(cuid())
  leadId          String   @unique
  contentMarkdown String   
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model OutreachEmail {
  id                  String   @id @default(cuid())
  leadId              String
  userId              String
  to                  String
  subject             String
  body                String   
  htmlContent         String?  
  replyTo             String?
  status              String   @default("DRAFT")
  sentAt              DateTime?
  gmailMessageId      String?  // Gmail message ID for history sync
  externalMessageId   String?
  externalThreadId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation("OutreachEmails", fields: [userId], references: [id], onDelete: Cascade)
  replies EmailReply[]
}

model EmailReply {
  id                  String   @id @default(cuid())
  outreachEmailId     String   @unique
  fromEmail           String
  fromName            String?
  body                String   
  htmlBody            String?  
  gmailMessageId      String
  gmailThreadId       String
  sentiment           String? // POSITIVE, NEGATIVE, NEUTRAL
  repliedAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  outreachEmail OutreachEmail @relation(fields: [outreachEmailId], references: [id], onDelete: Cascade)
}

model WebsiteProject {
  id          String   @id @default(cuid())
  leadId      String
  projectName String
  htmlContent String   
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  leadId      String   @unique
  sellerId    String
  askingPrice Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

